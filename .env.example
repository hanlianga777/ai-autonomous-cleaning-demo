# Copy this file to .env. Never commit the populated .env file.
# REAL mode requires both a local YOLO weight file and a DashScope key.
AI_LAB_MODE=real
AI_LAB_YOLO_MODEL=/absolute/path/to/yolo11n.pt
DASHSCOPE_API_KEY=
DASHSCOPE_VL_MODEL=qwen-vl-max
# Optional only when using a compatible private endpoint.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
