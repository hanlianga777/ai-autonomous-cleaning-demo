# Copy this file to .env. Never commit the populated .env file.
# `auto` stays in a stable local replay until both REAL prerequisites exist.
AI_LAB_MODE=auto
AI_LAB_YOLO_MODEL=/absolute/path/to/yolo11n.pt
DASHSCOPE_API_KEY=
DASHSCOPE_VL_MODEL=qwen-vl-max
# Image + real function calling for the bounded Multi-view Perception Agent.
# Uses the same configured provider/key; no local model download.
DASHSCOPE_AGENT_MODEL=qwen3-vl-plus
# Optional only when using a compatible private endpoint.
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
